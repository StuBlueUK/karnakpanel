ainer\"><h2>Hire our hall</h2><p class=\"kb-lead\">A bright hall and kitchen for parties, classes and meetings.</p><div class=\"kb-btns\"><a class=\"kb-btn\" href=\"/visit/\">Ask about hire</a></div></div></section><footer class=\"kb-footer\"><div class=\"kb-container\"><div class=\"kb-row\" style=\"--kb-cols:3\"><div class=\"kb-col\"><b>Unity Church</b><p>A welcoming church and community centre for everyone.</p></div><div class=\"kb-col\"><nav data-kb=\"menu\"><a href=\"/\">Home</a></nav></div><div class=\"kb-col\"><p>Church Road, Yourtown<br><a href=\"tel:+441632960737\">01632 960737</a><br><a href=\"mailto:office@example.com\">office@example.com</a></p></div></div></div></footer>","css":"","kind":"page","date":"","tags":[],"draft":false},{"slug":"whats-on","title":"What’s on","desc":"Weekly activities and events.","noindex":false,"nav":true,"html":"<header class=\"kb-header\"><div class=\"kb-container\"><a class=\"kb-brand\" href=\"/\">Unity Church</a><nav data-kb=\"menu\"><a href=\"/\">Home</a></nav></div></header><section class=\"kb-section kb-soft kb-center\"><div class=\"kb-container\"><span class=\"kb-eyebrow\">What’s on</span><h1>This week at Unity</h1><p class=\"kb-lead\">All groups are free unless shown.</p></div></section><section class=\"kb-section\"><div class=\"kb-container\"><h2>Weekly timetable</h2><table class=\"kb-table\"><thead><tr><th scope=\"col\">Day</th><th scope=\"col\">Time</th><th scope=\"col\">Activity</th></tr></thead><tbody><tr><th scope=\"row\">Sunday</th><td>10:30am</td><td>Family service</td></tr><tr><th scope=\"row\">Tuesday</th><td>10am–12pm</td><td>Community café</td></tr><tr><th scope=\"row\">Wednesday</th><td>9:30am</td><td>Toddler group</td></tr><tr><th scope=\"row\">Thursday</th><td>1pm–3pm</td><td>Food bank</td></tr><tr><th scope=\"row\">Friday</th><td>7pm</td><td>Youth club (11–16)</td></tr></tbody></table></div></section><section class=\"kb-section kb-soft\"><div class=\"kb-container\"><div class=\"kb-narrow\"><h2 class=\"k